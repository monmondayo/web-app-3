# 楽天市場API
# https://webservice.rakuten.co.jp/ で取得
RAKUTEN_APPLICATION_ID=your_rakuten_app_id_here

# Yahoo!ショッピングAPI
# https://e.developer.yahoo.co.jp/ で取得
YAHOO_CLIENT_ID=your_yahoo_client_id_here

# Amazon Product Advertising API（オプション）
# https://affiliate.amazon.co.jp/assoc_credentials/home
AMAZON_ACCESS_KEY=your_amazon_access_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_ASSOCIATE_TAG=your_amazon_associate_tag
